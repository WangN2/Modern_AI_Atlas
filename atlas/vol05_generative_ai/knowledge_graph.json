          "color": "#4f46e5",
          "items": [
            {
              "icon": "flow",
              "title": "自回归模型 (AutoRegressive)",
              "desc": "基于历史生成下一个元素；如: GPT 系列 · x1 → x2 → x3 → … → xn"
            },
            {
              "icon": "network",
              "title": "变分自编码器 (VAE)",
              "desc": "学习潜在空间分布进行生成；如: VAE, beta-VAE · 编码器 q(z|x) → z → 解码器 p(x|z)"
            },
            {
              "icon": "bolt",
              "title": "生成对抗网络 (GAN)",
              "desc": "生成器与判别器对抗训练；如: GAN, StyleGAN · 噪声 z → 生成器 G → 图像 → 判别器 D → 真/假"
            },
            {
              "icon": "layers",
              "title": "扩散模型 (Diffusion Models)",
              "desc": "通过逐步去噪生成高质量内容；如: Stable Diffusion, DALL-E 3 · 噪声 → 去噪步骤 → 图像"
            },
            {
              "icon": "flow",
              "title": "流匹配模型 (Flow Matching)",
              "desc": "学习连续变换将噪声映射到数据；如: SD3, Flux (Rectified Flow) · 噪声 → 数据"
            }
          ]
        },
