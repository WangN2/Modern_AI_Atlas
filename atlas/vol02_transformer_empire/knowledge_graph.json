    {
      "kind": "transformer_nexus",
      "title": "Transformer 核心总图",
      "subtitle": "Problem → Architecture → Information Flow → Three Architectural Modes",
      "color": "#3157c8",
      "top": [
        {
          "kind": "list",
          "weight": 0.92,
          "color": "#3157c8",
          "title": "旧世界的瓶颈，如何被击穿",
          "subtitle": "Problem / Breakthrough / Scaling Flywheel",
          "large_text": true,
          "columns": 1,
          "items": [
            {
              "icon": "flow",
              "title": "问题：RNN 必须按时间步顺序计算",
              "desc": "长距离信息要层层传递，训练慢，也容易遗忘早期内容。"
            },
            {
              "icon": "brain",
              "title": "突破：Self-Attention 让 token 直接通信",
              "desc": "一句话中的任意位置可直接比较相关性，依赖路径显著缩短。"
            },
            {
              "icon": "layers",
              "title": "工程优势：整段序列可以并行训练",
              "desc": "GPU/TPU 利用率提高，模型、数据和训练规模得以持续扩大。"
            },
            {
              "icon": "bolt",
              "title": "飞轮：预训练、迁移、规模化与能力涌现",
              "desc": "同一底座先学习通用表示，再通过微调、提示或工具连接完成任务。"
            }
          ],
          "summary": "关键不是 Attention 单点创新，而是算法、硬件与数据形成了扩展飞轮"
        },
        {
          "kind": "hero",
          "compact": true,
          "weight": 1.35,
          "color": "#3157c8",
          "title": "Transformer 标准架构",
          "subtitle": "Input / Embedding / Position / MHA / FFN / Output",
          "org": "Vaswani et al. · 2017",
          "caption": "Embedding 与位置编码形成 token 表示，多头注意力进行全局信息路由，FFN、残差连接与归一化稳定深层训练。",
          "formula": "Attention(Q,K,V) = softmax(QKᵀ / √dₖ)V",
          "decoder_color": "#7654c4",
          "encoder_blocks": [
            "Multi-Head Self-Attention",
            "Add & Norm",
            "Feed Forward Network",
            "Add & Norm"
          ],
          "decoder_blocks": [
            "Masked Self-Attention",
            "Cross-Attention",
            "Feed Forward Network",
            "Add & Norm"
          ]
        },
        {
          "kind": "list",
          "weight": 0.9,
          "color": "#1f8a70",
          "title": "一条信息如何穿过 Transformer",
          "subtitle": "Input / Representation / Output",
          "large_text": true,
          "columns": 1,
          "marker": "check",
          "items": [
            {
              "icon": "bolt",
              "title": "1. Tokenize：把输入切成可计算单元",
              "desc": "文字是子词，图像是 patch，声音和动作也可编码成 token。"
            },
            {
              "icon": "network",
              "title": "2. Embed：把 token 变成向量",
              "desc": "向量承载内容；位置编码补回顺序、空间或时间结构。"
            },
            {
              "icon": "layers",
              "title": "3. Attend：计算谁应该关注谁",
              "desc": "Q、K 衡量相关性，权重再汇聚 V 中携带的信息。"
            },
            {
              "icon": "circles",
              "title": "4. Transform：重组并提炼表示",
              "desc": "多头注意力、FFN、残差连接和归一化反复堆叠。"
            },
            {
              "icon": "rocket",
              "title": "5. Decode：得到理解结果或下一个 token",
              "desc": "输出可用于分类、检索、生成，也可连接工具和动作空间。"
            }
          ],
          "summary": "一句话：把不同输入变成 token，用注意力路由信息，再产生表示或预测"
        }
      ],
      "modes": {
        "kind": "cards",
        "color": "#3157c8",
        "title": "三类核心架构",
        "subtitle": "One Core, Three Operating Modes",
        "large_text": true,
        "columns": 3,
        "compact_header": true,
        "max_card_stretch": 1.08,
        "items": [
        {
          "title": "Encoder",
          "title_en": "Bidirectional Understanding",
          "icon": "book",
          "color": "#3569b8",
          "bullet_columns": 2,
          "desc": "每个 token 同时读取左右上下文，形成面向理解的双向表示。",
          "summary": "例：‘这家店很好’ -> 正面情感；文档 -> 语义向量",
          "items": [
            "读什么：一次看见输入左右两侧的完整上下文",
            "产出什么：句子或逐 token 的上下文表示",
            "适合什么：分类、检索、抽取、语义匹配",
            "代表路线：BERT、RoBERTa、DeBERTa、E5 / BGE"
          ]
        },
        {
          "title": "Decoder",
          "title_en": "Autoregressive Generation",
          "icon": "flow",
          "color": "#3157c8",
          "bullet_columns": 2,
          "desc": "用因果掩码只读取已有 token，逐步预测下一个 token。",
          "summary": "例：‘北京是中国的’ -> ‘首都’；提示词 -> 连续回答",
          "items": [
            "读什么：只能关注当前位置之前已经出现的 token",
            "产出什么：逐步预测下一个 token，循环形成长输出",
            "适合什么：对话、写作、代码、推理和工具调用",
            "代表路线：GPT、LLaMA、Qwen、Mistral、DeepSeek"
          ]
        },
        {
          "title": "Encoder-Decoder",
          "title_en": "Sequence to Sequence",
          "icon": "network",
          "color": "#7654c4",
          "bullet_columns": 2,
          "desc": "Encoder 理解输入，Decoder 通过交叉注意力按条件生成输出。",
          "summary": "例：How are you? -> 你好吗？；长文 -> 摘要",
          "items": [
            "读什么：Encoder 先理解完整输入，Decoder 再读取它",
            "产出什么：受输入条件约束、长度可不同的新序列",
            "适合什么：翻译、摘要、改写和结构化转换",
            "代表路线：T5 / BART / mT5 / NLLB / PEGASUS"
          ]
        }
        ]
      }
    },
