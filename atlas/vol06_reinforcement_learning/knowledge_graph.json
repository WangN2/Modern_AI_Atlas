    {
      "row": [
        {
          "kind": "list",
          "title": "马尔可夫决策过程",
          "subtitle": "Markov Decision Process (MDP)",
          "weight": 1.0,
          "color": "#4f46e5",
          "items": [
            {
              "icon": "layers",
              "title": "建模为 MDP: (S, A, P, R, gamma)"
            },
            {
              "icon": "cube",
              "title": "S: 状态空间 · A: 动作空间"
            },
            {
              "icon": "flow",
              "title": "P: 状态转移概率 P(s'|s,a)"
            },
            {
              "icon": "star",
              "title": "R: 奖励函数 R(s,a,s')"
            },
            {
              "icon": "gear",
              "title": "gamma in [0,1): 折扣因子"
            },
            {
              "icon": "target",
              "title": "目标: 找到最优策略 pi*"
            },
            {
              "icon": "chart",
              "title": "最大化 J(pi) = E[ sum_t gamma^t r_t ]"
            }
          ]
        },
        {
          "kind": "list",
          "title": "贝尔曼方程",
          "subtitle": "Bellman Equation",
          "weight": 1.0,
          "color": "#3b82f6",
          "items": [
            {
              "icon": "chart",
              "title": "状态价值函数 V^pi(s)",
              "desc": "V^pi(s) = E_pi[ r + gamma V^pi(s') | s ]"
            },
            {
              "icon": "chart",
              "title": "动作价值函数 Q^pi(s,a)",
              "desc": "Q^pi(s,a) = E_pi[ r + gamma Q^pi(s',a') | s,a ]"
            },
            {
              "icon": "star",
              "title": "最优贝尔曼方程 V*(s)",
              "desc": "V*(s) = max_a sum_{s',r} P(s',r|s,a) [ r + gamma V*(s') ]"
            },
            {
              "icon": "star",
              "title": "最优贝尔曼方程 Q*(s,a)",
              "desc": "Q*(s,a) = sum_{s',r} P(s',r|s,a) [ r + gamma max_{a'} Q*(s',a') ]"
            }
          ]
        },
        {
          "kind": "list",
          "title": "价值函数与策略的关系",
          "subtitle": "Value-Policy Relationship",
          "weight": 1.0,
          "color": "#a855f7",
          "items": [
            {
              "icon": "flow",
              "title": "价值函数指导策略改进",
              "desc": "评估 (Evaluation): 估计 V^pi 或 Q^pi"
            },
            {
              "icon": "gear",
              "title": "改进 (Improvement)",
              "desc": "更新策略 pi <- pi'"
            },
            {
              "icon": "bolt",
              "title": "策略改进提升价值函数",
              "desc": "更好的策略 pi' 带来更高的期望回报"
            }
          ]
        }
      ]
    },
